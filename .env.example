# AIVOT — configurazione locale
# Copia questo file in `.env` e compila ciò che ti serve:
#   cp .env.example .env
# Tutto è FACOLTATIVO: senza .env la piattaforma parte comunque
# (le email vengono semplicemente saltate e annotate nei log).
# Ogni valore è modificabile anche a caldo dal backoffice Django
# (/admin/ -> Configurazione piattaforma).

# --- Email transazionali (Brevo) -------------------------------------
# Chiave API: https://app.brevo.com/settings/keys/api
# Attenzione: se il tuo account Brevo ha la restrizione IP attiva,
# autorizza l'IP del server (https://app.brevo.com/security/authorised_ips)
BREVO_API_KEY=

# Mittente: DEVE essere un mittente validato su Brevo o un dominio
# autenticato (SPF/DKIM), altrimenti Brevo accetta e poi scarta l'invio.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AIVOT

# --- Accesso con Google (facoltativo) ---------------------------------
# OAuth Client ID da Google Cloud Console -> API e servizi -> Credenziali
# (tipo: applicazione web, origine http://localhost:5173).
# Vuoto = il bottone Google non compare.
GOOGLE_CLIENT_ID=

# --- Superadmin del backoffice (/admin/) ------------------------------
# Creato automaticamente al primo avvio se non esiste alcun superuser.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aivot-admin
ADMIN_EMAIL=admin@aivot.local

# --- Piattaforma -------------------------------------------------------
# URL pubblico del frontend: usato nei link delle email (reset password)
FRONTEND_URL=http://localhost:5173

# Produzione: DEBUG=0 e una SECRET_KEY tua (obbligatoria con DEBUG=0)
DEBUG=1
SECRET_KEY=
