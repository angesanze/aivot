# Segreti e configurazione locale
.env

# Python
__pycache__/
*.pyc
*.sqlite3
backend/staticfiles/

# Node
node_modules/
dist/

# Terraform (stato e cache locali; il lock file invece si versiona)
infra/.terraform/
*.tfstate
*.tfstate.*
infra/*.tfvars
!infra/*.tfvars.example
# backend.tf lo genera deploy.sh quando si usa lo stato remoto (CI/CD):
# non va versionato, altrimenti romperebbe il deploy locale a stato locale.
infra/backend.tf
# Chiavi service account scaricate da deploy.sh per la pipeline: mai versionarle
*-key.json
key.json

# Sistema
.DS_Store

# Coordinamento agenti (stato locale, non versionato)
.agents/
.agents/memory.json
