---
import { links } from "../data/site";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    eyebrow: "The part nobody else gets right",
    title: "When there's no schedule, most tools just fail. AIVOT tells you why.",
    body: "Ask for the impossible and other planners return a blank grid or an unhelpful error. AIVOT finds the smallest set of rules that can't hold together — so you relax the right one instead of guessing.",
    points: [
      "It names the conflicting rules, not a generic \"infeasible\".",
      "It isolates the minimal conflict, so you know the real cause.",
      "You make one informed decision — and re-run.",
    ],
    cta: "See it on your problem",
    reportTitle: "No feasible schedule",
    reportLead: "These rules can't all hold at once:",
    rules: [
      { text: "Coverage: 3 nurses every night", kind: "hard" },
      { text: "Max 5 shifts / nurse / week", kind: "hard" },
      { text: "Ana unavailable Fri–Sun", kind: "hard" },
    ],
    hint: "Relax one of these to make it solvable.",
    hard: "hard",
  },
  it: {
    eyebrow: "La parte che nessun altro azzecca",
    title: "Quando non c'è pianificazione, gli altri strumenti falliscono. AIVOT ti dice perché.",
    body: "Chiedi l'impossibile e gli altri pianificatori restituiscono una griglia vuota o un errore inutile. AIVOT trova l'insieme minimo di regole che non possono coesistere — così allenti quella giusta invece di tirare a indovinare.",
    points: [
      "Nomina le regole in conflitto, non un generico \"infeasible\".",
      "Isola il conflitto minimo, così conosci la causa vera.",
      "Prendi una sola decisione informata — e rilanci.",
    ],
    cta: "Provalo sul tuo problema",
    reportTitle: "Nessuna pianificazione possibile",
    reportLead: "Queste regole non possono valere tutte insieme:",
    rules: [
      { text: "Copertura: 3 infermieri ogni notte", kind: "hard" },
      { text: "Max 5 turni / infermiere / settimana", kind: "hard" },
      { text: "Ana non disponibile ven–dom", kind: "hard" },
    ],
    hint: "Allenta una di queste per renderla risolvibile.",
    hard: "rigida",
  },
}[lang];
---

<section id="solver" class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold text-amber-400">{L.eyebrow}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-balance text-zinc-50 sm:text-4xl">
        {L.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{L.body}</p>
      <ul class="mt-6 space-y-3">
        {
          L.points.map((p) => (
            <li class="flex gap-3 text-zinc-300">
              <svg class="mt-1 h-4 w-4 flex-none text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      <a
        href={links.app}
        class="mt-8 inline-flex rounded-lg bg-emerald-600 px-6 py-3 font-medium text-white shadow-[0_0_30px_-6px_rgb(16_185_129/0.65)] transition hover:bg-emerald-500"
      >
        {L.cta}
      </a>
    </div>

    <!-- the conflict report card -->
    <div class="relative">
      <div
        class="pointer-events-none absolute -inset-6 -z-10 bg-[radial-gradient(ellipse_60%_60%_at_60%_40%,rgb(251_191_36/0.14),transparent)]"
      >
      </div>
      <div class="overflow-hidden rounded-xl border border-amber-500/20 bg-zinc-900/80 shadow-2xl shadow-black/50">
        <div class="flex items-center gap-2.5 border-b border-white/[0.06] bg-amber-500/[0.06] px-4 py-3">
          <svg class="h-4 w-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
            <path d="M12 9v4M12 17h.01" />
          </svg>
          <span class="text-sm font-semibold text-amber-200">{L.reportTitle}</span>
        </div>
        <div class="p-5">
          <p class="text-sm text-zinc-400">{L.reportLead}</p>
          <ul class="mt-4 space-y-2">
            {
              L.rules.map((r) => (
                <li class="flex items-center justify-between gap-3 rounded-lg border border-white/[0.06] bg-zinc-950/50 px-3 py-2.5">
                  <span class="flex items-center gap-2.5 text-[13px] text-zinc-200">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber-400" />
                    {r.text}
                  </span>
                  <span class="rounded border border-white/[0.06] bg-white/[0.03] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-zinc-500">
                    {L.hard}
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="mt-4 flex items-center gap-2 rounded-lg bg-emerald-500/[0.07] px-3 py-2.5 text-[13px] text-emerald-300">
            <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
            {L.hint}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
