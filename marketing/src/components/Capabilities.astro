---
import { capabilitiesSection } from "../data/capabilities";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = capabilitiesSection[lang];
---

<section id="features" class="border-y border-white/[0.06] bg-zinc-900/30">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-emerald-400">{s.eyebrow}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">
        {s.title}
      </h2>
      <p class="mt-4 text-zinc-400">{s.subtitle}</p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        s.capabilities.map((cap) => (
          <div class="rounded-xl border border-white/[0.06] bg-zinc-950/40 p-6">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-400 [&>svg]:h-5 [&>svg]:w-5">
              <Fragment set:html={cap.icon} />
            </div>
            <h3 class="font-semibold text-zinc-100">{cap.title}</h3>
            <p class="mt-1 text-sm text-zinc-500">{cap.tagline}</p>
            <ul class="mt-4 space-y-2">
              {cap.items.map((it) => (
                <li class="flex gap-2.5 text-sm text-zinc-400">
                  <svg
                    class="mt-1 h-3.5 w-3.5 flex-none text-emerald-500"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
