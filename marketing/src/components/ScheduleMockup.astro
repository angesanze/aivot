---
// Faithful HTML/CSS mock of AIVOT's UI (no real screenshots exist, so this
// stands in for one). Dark tokens: canvas #09090b, panels zinc-900, borders
// white/6%, accent emerald/teal, amber for the "optimal" solution.
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    steps: ["Project", "People", "Rules", "Shifts", "Plan"],
    title: "Hospital ward",
    subtitle: "9 nurses · 7 days · M / P / N",
    optimal: "Optimal",
    rulesOk: "12 rules satisfied",
    conflicts: "0 conflicts",
    days: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
  },
  it: {
    steps: ["Progetto", "Persone", "Regole", "Turni", "Pianifica"],
    title: "Reparto ospedaliero",
    subtitle: "9 infermieri · 7 giorni · M / P / N",
    optimal: "Ottima",
    rulesOk: "12 regole rispettate",
    conflicts: "0 conflitti",
    days: ["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"],
  },
}[lang];

// shift tokens: M = morning (emerald), P = afternoon (teal/cyan), N = night
// (amber), "" = rest. Each row is one person's week.
const grid: { name: string; week: string[] }[] = [
  { name: "Ana", week: ["M", "M", "P", "", "N", "N", ""] },
  { name: "Bea", week: ["P", "P", "", "M", "M", "", "N"] },
  { name: "Carla", week: ["N", "", "M", "M", "P", "P", ""] },
  { name: "Dana", week: ["", "N", "N", "P", "", "M", "M"] },
  { name: "Elsa", week: ["M", "P", "P", "", "M", "", "N"] },
  { name: "Fara", week: ["P", "", "M", "N", "", "P", "M"] },
];

const cell: Record<string, string> = {
  M: "bg-emerald-500/15 text-emerald-300 ring-emerald-500/25",
  P: "bg-teal-500/15 text-teal-200 ring-teal-500/25",
  N: "bg-amber-500/15 text-amber-300 ring-amber-500/25",
  "": "bg-zinc-800/40 text-zinc-700 ring-white/[0.04]",
};
---

<div
  class="overflow-hidden rounded-xl border border-white/[0.08] bg-zinc-900/80 shadow-2xl shadow-black/60 ring-1 ring-white/[0.04] backdrop-blur"
>
  <!-- window chrome -->
  <div class="flex items-center gap-2 border-b border-white/[0.06] bg-zinc-900 px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
    <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
    <div
      class="ml-3 flex items-center gap-1.5 rounded-md bg-zinc-800/70 px-2.5 py-1 text-[11px] text-zinc-500"
    >
      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><rect x="3" y="11" width="18" height="11" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
        ></path></svg
      >
      app.aivot.rocks
    </div>
  </div>

  <div class="flex min-h-[420px]">
    <!-- sidebar: the 5-step flow, "Plan" active -->
    <aside class="hidden w-52 shrink-0 flex-col border-r border-white/[0.06] bg-zinc-900 p-3 sm:flex">
      <div class="flex items-center gap-2.5 px-2 pb-4">
        <img src="/logo.svg" alt="" width="26" height="26" class="rounded-md" />
        <div class="leading-tight">
          <div class="wordmark text-[13px] font-bold text-zinc-100">AIVOT</div>
          <div class="text-[10px] text-zinc-500">{L.title}</div>
        </div>
      </div>
      {
        L.steps.map((label, i) => {
          const active = i === L.steps.length - 1;
          return (
            <div
              class:list={[
                "relative mb-0.5 flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-[13px]",
                active ? "bg-emerald-500/10 font-medium text-zinc-100" : "text-zinc-400",
              ]}
            >
              {active && (
                <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-emerald-500" />
              )}
              <span
                class:list={[
                  "flex h-4 w-4 items-center justify-center rounded-full text-[9px] font-semibold",
                  active ? "bg-emerald-500 text-zinc-950" : "bg-zinc-800 text-zinc-500",
                ]}
              >
                {i + 1}
              </span>
              {label}
            </div>
          );
        })
      }
    </aside>

    <!-- main: the solved schedule grid -->
    <div class="flex-1 space-y-4 p-4 sm:p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="text-lg font-semibold text-zinc-50">{L.title}</div>
          <div class="text-xs text-zinc-500">{L.subtitle}</div>
        </div>
        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-[11px] font-medium text-amber-300"
        >
          <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"
            ><path
              fill-rule="evenodd"
              d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z"
              clip-rule="evenodd"></path></svg
          >
          {L.optimal}
        </span>
      </div>

      <div class="overflow-hidden rounded-xl border border-white/[0.06] bg-zinc-950/40">
        <!-- header row: days -->
        <div class="grid grid-cols-[64px_repeat(7,1fr)] border-b border-white/[0.06] bg-white/[0.02]">
          <div class="px-2 py-2"></div>
          {L.days.map((d) => (
            <div class="px-1 py-2 text-center text-[10px] font-medium text-zinc-500">{d}</div>
          ))}
        </div>
        <!-- one row per person -->
        {
          grid.map((row) => (
            <div class="grid grid-cols-[64px_repeat(7,1fr)] border-b border-white/[0.04] last:border-0">
              <div class="flex items-center px-2 py-1.5 text-[11px] font-medium text-zinc-400">
                {row.name}
              </div>
              {row.week.map((s) => (
                <div class="flex items-center justify-center p-1">
                  <span
                    class:list={[
                      "flex h-6 w-full items-center justify-center rounded-md text-[10px] font-semibold ring-1 ring-inset",
                      cell[s],
                    ]}
                  >
                    {s}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <!-- constraints panel -->
      <div class="flex flex-wrap items-center gap-3 text-[11px]">
        <span class="inline-flex items-center gap-1.5 text-emerald-400">
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"
            ><path
              fill-rule="evenodd"
              d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z"
              clip-rule="evenodd"></path></svg
          >
          {L.rulesOk}
        </span>
        <span class="text-zinc-700">·</span>
        <span class="text-zinc-500">{L.conflicts}</span>
        <span class="ml-auto flex items-center gap-3 text-zinc-600">
          <span class="flex items-center gap-1.5"
            ><span class="h-2 w-2 rounded-sm bg-emerald-500/60"></span>M</span
          >
          <span class="flex items-center gap-1.5"
            ><span class="h-2 w-2 rounded-sm bg-teal-500/60"></span>P</span
          >
          <span class="flex items-center gap-1.5"
            ><span class="h-2 w-2 rounded-sm bg-amber-500/60"></span>N</span
          >
        </span>
      </div>
    </div>
  </div>
</div>
